# Never put real secrets in this file or commit them.
ROSETTA_CONFIG=/etc/rosetta/config.yaml
ROSETTA_MODE=dry_run
ROSETTA_LOG_LEVEL=INFO
ROSETTA_DATABASE=/var/lib/rosetta/state/rosetta.sqlite3
ROSETTA_EVIDENCE_DIR=/var/lib/rosetta/evidence
SIGNER_SOCKET=/run/rosetta-signer/signer.sock

# Configure a model provider only after the provider adapter and budget controls
# have been implemented. Supply secrets through the deployment secret manager,
# not this file.
MODEL_API_KEY=

# The publisher is disabled in the MVP. If it is later approved, inject a
# destination-scoped credential only into the publisher service.
PUBLISHER_CREDENTIAL=
