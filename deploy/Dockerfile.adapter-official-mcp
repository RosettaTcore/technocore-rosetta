ARG PYTHON_BASE_IMAGE=python@sha256:c24c34b502635f1f7c4e99dc09a2cbd85d480b7dcfd077198c6b5af138906390
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN addgroup --system --gid 65532 rosetta && \
    adduser --system --uid 65532 --ingroup rosetta --home /nonexistent --no-create-home rosetta
WORKDIR /opt/rosetta
COPY adapters/official_mcp/requirements.lock ./requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes --requirement requirements.lock
COPY vendor/technocore-chat-v0.13.0/mcp ./vendor/technocore-chat-v0.13.0/mcp
RUN python -m pip install --no-cache-dir --no-deps ./vendor/technocore-chat-v0.13.0/mcp
COPY adapters/official_mcp ./adapters/official_mcp
RUN chmod -R u=rwX,go=rX adapters vendor
USER 65532:65532
RUN python -c "from mcp import ClientSession; import technocore_mcp.server as s; assert s.VERSION == '0.13.0'"
ENTRYPOINT ["python"]
