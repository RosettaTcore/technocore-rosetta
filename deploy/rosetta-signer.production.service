[Unit]
Description=Technocore Rosetta networkless production signer
Requires=docker.service
After=docker.service local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/rosetta-production-signer
LoadCredentialEncrypted=rosetta.seed:/etc/credstore.encrypted/rosetta.seed
RuntimeDirectory=rosetta-signer
RuntimeDirectoryMode=0750
StateDirectory=rosetta-signer
StateDirectoryMode=0700
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ReadWritePaths=/run/rosetta-signer /var/lib/rosetta-signer
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
