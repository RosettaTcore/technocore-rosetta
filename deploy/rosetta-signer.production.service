[Unit]
Description=Technocore Rosetta networkless production signer
Requires=docker.service
After=docker.service local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/rosetta-production-signer
LoadCredentialEncrypted=rosetta.seed:/etc/credstore.encrypted/rosetta.seed
RuntimeDirectory=rosetta-signer
# Permit a non-signer validator to stat the known socket path without listing this directory.
# The 0660 socket still admits only the signer identity and explicitly approved clients.
RuntimeDirectoryMode=0751
# The container runs as the fixed signer UID while this host supervisor must remain root to
# control Docker and load the encrypted credential. Do not use StateDirectory= here: systemd
# would recursively re-own the persistent SQLite database to the host service user on restart.
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ReadWritePaths=/run/rosetta-signer /var/lib/rosetta-signer
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
