[Unit]
Description=Technocore Rosetta networkless production signer
After=local-fs.target

[Service]
Type=simple
User=rosetta-signer
Group=rosetta-signer
ExecStart=/opt/rosetta/current/.venv/bin/rosetta-signer --socket /run/rosetta-signer/signer.sock --state /var/lib/rosetta-signer/nonce.sqlite3 --seed-file %d/rosetta.seed
LoadCredentialEncrypted=rosetta.seed:/etc/credstore.encrypted/rosetta.seed
RuntimeDirectory=rosetta-signer
RuntimeDirectoryMode=0700
StateDirectory=rosetta-signer
StateDirectoryMode=0700
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ReadWritePaths=/run/rosetta-signer /var/lib/rosetta-signer
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target
