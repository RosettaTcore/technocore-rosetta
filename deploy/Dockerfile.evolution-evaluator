# Fixed, credential-free evaluator for closed evolution candidates.
ARG PYTHON_BASE_IMAGE=python@sha256:c24c34b502635f1f7c4e99dc09a2cbd85d480b7dcfd077198c6b5af138906390
ARG NODE_BASE_IMAGE=node@sha256:d272d96f3ad3a4e5bb2b6c36ea7427b4e83d1b23fb24b9df8b71d01aa59951b1

FROM ${NODE_BASE_IMAGE} AS node-tools
WORKDIR /opt/node-tools
COPY adapters/package.json adapters/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM ${PYTHON_BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN addgroup --system --gid 65532 evaluator && \
    adduser --system --uid 65532 --ingroup evaluator --home /nonexistent --no-create-home evaluator

WORKDIR /opt/evaluator
COPY requirements.lock requirements-dev.lock pyproject.toml ./
RUN python -m pip install --no-cache-dir --requirement requirements-dev.lock
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tools /opt/node-tools/node_modules ./node_modules
COPY tools/evolution_container_gate.py ./evolution_container_gate.py

USER 65532:65532
ENTRYPOINT ["python", "/opt/evaluator/evolution_container_gate.py"]
